---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeroDefilant from "../components/HeroDefilant.astro";
import SectionChiffres from "../components/SectionChiffres.astro";
import SectionDisciplines from "../components/SectionDisciplines.astro";
import SectionEvenements from "../components/SectionEvenements.astro";
import SectionActus from "../components/SectionActus.astro";
import SectionGalerie from "../components/SectionGalerie.astro";
import SectionInfosPratiques from "../components/SectionInfosPratiques.astro";
import SectionPartenaires from "../components/SectionPartenaires.astro";
import { aujourdhuiParis, dansLeFil, estAVenir } from "../lib/agenda";

const [reglagesArr, actualitesArr, partenairesArr] = await Promise.all([
  getCollection("reglages"),
  getCollection("actualites"),
  getCollection("partenaires"),
]);

const reglages = reglagesArr[0]?.data;

// Une fiche par rendez-vous : à venir tant que sa date n'est pas passée, puis
// dans le fil des actualités dès qu'elle a un compte rendu.
const aujourdhui = aujourdhuiParis();
const fiches = actualitesArr.map((e) => ({ ...e.data, slug: e.id, corps: e.body ?? "" }));
const evenements = fiches
  .filter((f) => estAVenir(f, aujourdhui))
  .sort((a, b) => a.date.getTime() - b.date.getTime())
  .slice(0, 3);
const actus = fiches
  .filter((f) => dansLeFil(f, f.corps, aujourdhui))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 3);

const partenaires = partenairesArr.map((p) => p.data);

// Photos du slider hero : géré dans l'admin (Réglages → Photos du bandeau
// d'accueil). Repli sur les photos migrées si le champ est vide.
const poolHero: string[] = reglages?.photosHero?.length
  ? reglages.photosHero
  : [
      "/medias/hero/competition-huit.jpeg",
      "/medias/hero/hero-1.jpeg",
      "/medias/hero/competition-macon.jpeg",
      "/medias/hero/hero-3.jpeg",
    ];
// Pool de la galerie home : photos des actualités (résultats compris), légendées par
// le nom de l'événement et pointant vers l'article correspondant.
const photosActualites = actualitesArr
  .filter((e) => e.data.image)
  .map((e) => ({ titre: e.data.titre, date: e.data.date, src: e.data.image as string, href: `/actualites/${e.id}` }));

const poolGalerie = photosActualites
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 8)
  .map(({ src, titre, href }) => ({ src, alt: titre, href }));
---
<BaseLayout title="Cercle Nautique de France — L'aviron aux portes de Paris">
  <Nav slot="header" />
  <HeroDefilant medias={poolHero.map((src) => ({ src }))} />
  {reglages && <SectionChiffres accroche={reglages.accroche} chiffres={reglages.chiffres} />}
  <SectionDisciplines />
  <SectionEvenements evenements={evenements} />
  <SectionActus actus={actus} />
  <SectionGalerie photos={poolGalerie} />
  {reglages && <SectionInfosPratiques horaires={reglages.infos.horaires} tarifs={reglages.infos.tarifs} adresse={reglages.infos.adresse} email={reglages.infos.email} />}
  <SectionPartenaires partenaires={partenaires} />
  <Footer slot="footer" />
</BaseLayout>
