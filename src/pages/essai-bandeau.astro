---
// Page cachée (non liée, non indexée) pour essayer le bandeau défilant sur
// téléphone avant de l'adopter sur l'accueil.
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import HeroDefilant from "../components/HeroDefilant.astro";

const reglages = (await getCollection("reglages"))[0]?.data;
const photos = (reglages?.photosHero ?? []).map((src) => ({ src }));
// Vidéo de test (paysage, 20 s) glissée en troisième position.
const VIDEO_TEST = { src: "/medias/8639abbd-9ad2-484e-8a50-e30963942913.mov" };
const medias = [...photos.slice(0, 2), VIDEO_TEST, ...photos.slice(2)];
---
<BaseLayout title="Essai du bandeau — Cercle Nautique de France" noindex>
  <Nav slot="header" />
  <HeroDefilant medias={medias} />
  <section id="suite" class="essai">
    <div class="wrap">
      <h2>Essai du bandeau défilant</h2>
      <p>Page de test, non référencée. À ouvrir sur un téléphone tenu en hauteur :</p>
      <ul>
        <li>le bandeau occupe tout l'écran ;</li>
        <li>chaque photo glisse latéralement pour être vue en entier, en alternant le sens, puis laisse place à la suivante ;</li>
        <li>la vidéo (3<sup>e</sup>) joue sans son, cadrée au centre, sans défilement, puis le diaporama reprend ;</li>
        <li>la flèche en bas descend vers la suite de la page.</li>
      </ul>
      <p>Sur ordinateur, le bandeau se comporte comme celui de l'accueil (fondu enchaîné).</p>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
<style>
  .essai { padding-block: 3rem; }
  .essai ul { margin: 1rem 0; padding-left: 1.2rem; line-height: 1.7; }
</style>
